{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BNO Tracker",
  "version": "0.2.1",
  "identifier": "uk.bnotracker.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8765",
    "beforeDevCommand": "npm run sync",
    "beforeBuildCommand": "npm run sync"
  },
  "app": {
    "windows": [
      {
        "title": "BNO Tracker",
        "width": 1100,
        "height": 850,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "category": "Utility",
    "shortDescription": "BNO visa absence-day and ILR eligibility tracker",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
